# What the game can actually see, printed in chat. Run it while the song plays.
#
# Nothing in this pack can be verified from the outside: a red sky that is not red, a beat that is
# off by a second and a title that never reaches the client all look identical from a scoreboard,
# so these counters exist to turn "the sky is normal" into a number. #tk is the important one: if it
# does not climb once per game tick, the tick loop is not running at all and every other answer is
# beside the point.
tellraw @a ["",{"text":"DEUS-BUILD ","color":"gold","bold":true},{"text":"1.0.34","color":"red","bold":true}]
scoreboard players set #panels deusex 0
execute as @e[type=minecraft:text_display,tag=deusex_flash] run scoreboard players add #panels deusex 1
tellraw @a ["",{"text":"DEUS-LOOP ","color":"yellow"},{"text":"ticks ","color":"gray"},{"score":{"name":"#tk","objective":"deusex"}},{"text":"  state ","color":"gray"},{"score":{"name":"#state","objective":"deusex"}},{"text":"  opening ","color":"gray"},{"score":{"name":"#ostage","objective":"deusex"}},{"text":"  closing ","color":"gray"},{"score":{"name":"#cstate","objective":"deusex"}}]
tellraw @a ["",{"text":"DEUS-CLOCK ","color":"yellow"},{"text":"#E ","color":"gray"},{"score":{"name":"#E","objective":"deusex"}},{"text":"  chunk ","color":"gray"},{"score":{"name":"#idx","objective":"deusex"}},{"text":"  t ","color":"gray"},{"score":{"name":"#t","objective":"deusex"}},{"text":"  lead ","color":"gray"},{"score":{"name":"#lead","objective":"deusex"}},{"text":"  gapless ","color":"gray"},{"score":{"name":"#full","objective":"deusex"}},{"text":"  drop ","color":"gray"},{"score":{"name":"#drop","objective":"deusex"}}]
tellraw @a ["",{"text":"DEUS-HEART ","color":"yellow"},{"text":"beats fired ","color":"gray"},{"score":{"name":"#beats","objective":"deusex"}}]
tellraw @a ["",{"text":"DEUS-RED ","color":"yellow"},{"text":"flashes ","color":"gray"},{"score":{"name":"#flashes","objective":"deusex"}},{"text":"  panel ticks left ","color":"gray"},{"score":{"name":"#fframe","objective":"deusex"}},{"text":"  next flash in ","color":"gray"},{"score":{"name":"#flashd","objective":"deusex"}},{"text":"  sky panels alive ","color":"gray"},{"score":{"name":"#panels","objective":"deusex"}},{"text":" (3 per player while lit)","color":"gray"},{"text":"  veil ","color":"gray"},{"score":{"name":"#wash","objective":"deusex"}},{"text":"/","color":"gray"},{"score":{"name":"#washmax","objective":"deusex"}},{"text":" (held ","color":"gray"},{"score":{"name":"#washbase","objective":"deusex"}},{"text":")","color":"gray"},{"text":"  painted cell ","color":"gray"},{"score":{"name":"#lv","objective":"deusex"}},{"text":"  tint ceiling ","color":"gray"},{"score":{"name":"#tint","objective":"deusex"}}]
tellraw @a ["",{"text":"DEUS-ASK ","color":"green"},{"text":"right now: are the rain drops themselves red? that is the pack's own assets/minecraft rain.png, and it is the only thing in the game that can colour a drop. Does the whole screen have a red cast (the veil, #wash of #washmax, held at #washbase)? Is any part of the sky red (the panel, 3 text_display per player while lit)? Nothing else is supposed to be in the air - the pack draws no /particle at all. If it rains while the song is NOT running the gate is broken: load.mcfunction turns the world's weather cycle off so the show is the only thing that can start rain, and an idle sky gets cleared.","color":"white"}]
tellraw @a ["",{"text":"DEUS-LYRIC ","color":"yellow"},{"text":"line ","color":"gray"},{"score":{"name":"#li","objective":"deusex"}}]
